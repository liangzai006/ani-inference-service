# Pinned platform dependency releases for the new-environment installer.
# Keep these versions together: KServe 0.16's LLMInferenceService controller
# expects LWS 0.6.2, Gateway API 1.2.1+, and GIE 0.3.0+.
# cert-manager 1.18+ is a shared cluster component, like PostgreSQL and
# Ceph/S3. The installer adopts an already-ready installation and installs
# this pinned release only when the new cluster has no cert-manager resources.
CERT_MANAGER_VERSION=v1.18.2
KSERVE_VERSION=v0.16.0
LWS_VERSION=v0.6.2
HIGRESS_VERSION=2.2.4
GATEWAY_API_VERSION=v1.6.0
GIE_VERSION=v0.3.0
